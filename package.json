{
  "name": "oau-campus-security",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack && node -e \"console.log('BUILD_PASSED')\"",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit && node -e \"console.log('TYPECHECK_PASSED')\"",
    "db:generate": "prisma generate",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test tests/integration.test.ts && node -e \"console.log('INTEGRATION_PASSED')\"",
    "test:e2e": "playwright test && node -e \"console.log('BROWSER_PASSED')\"",
    "check:syntax": "node scripts/check-syntax.cjs",
    "check:access": "node scripts/check-access.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "next-auth": "5.0.0-beta.30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.34.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.6.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
