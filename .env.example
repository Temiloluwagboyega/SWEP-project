# Local SQLite demo; never deploy this file database on Vercel.
DATABASE_URL="file:./dev.db"
# Generate a unique secret: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Resend email (https://resend.com/api-keys). Leave blank to skip sending in local dev.
RESEND_API_KEY=""
# Must use a domain verified in Resend; onboarding@resend.dev only delivers to your own account email.
EMAIL_FROM="Campus Security <onboarding@resend.dev>"
