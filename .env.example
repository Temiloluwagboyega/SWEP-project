# Local demo only. Run npm run env:setup to create a private .env and random secret.
APP_ENV="local"
DATABASE_URL="file:./dev.db"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Leave empty unless your trusted reverse proxy overwrites this single-IP header.
# Never trust a header supplied directly by an Internet client.
TRUSTED_CLIENT_IP_HEADER=""
# Hosting: APP_ENV=production, canonical HTTPS AUTH_URL, fresh private AUTH_SECRET,
# PostgreSQL DATABASE_URL, and a PostgreSQL-specific Prisma schema/migration history.
# The checked-in SQLite schema is only for local development. See docs/security.md.
