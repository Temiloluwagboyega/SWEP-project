# Run npm run env:setup to create a private .env and a random AUTH_SECRET.
# local = localhost demo; production = public HTTPS host (Vercel).
APP_ENV="local"
# PostgreSQL (Neon via Vercel Storage). Copy the connection strings from Vercel → Storage →
# your database → Open in Neon. Use a separate Neon development branch, not production.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"
# Integration tests create and drop a temporary schema in this database.
TEST_DATABASE_URL=""
AUTH_SECRET=""
# Local canonical origin. On Vercel use a public HTTPS AUTH_URL, or leave it
# unset to use trusted Vercel system domains. Use APP_ENV=production on Vercel.
AUTH_URL="http://localhost:3000"
# Leave empty unless your trusted reverse proxy overwrites this single-IP header.
# Never trust a header supplied directly by an Internet client.
TRUSTED_CLIENT_IP_HEADER=""
# Email over SMTP. For Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords (16 characters, no spaces). Leave blank to skip sending.
SMTP_USER=""
SMTP_PASS=""
# Optional: defaults to Gmail (smtp.gmail.com, port 465) and "Campus Security <SMTP_USER>".
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# EMAIL_FROM="Campus Security <you@gmail.com>"
