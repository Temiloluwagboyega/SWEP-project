# Local SQLite demo; never deploy this file database on Vercel.
DATABASE_URL="file:./dev.db"
# Generate a unique secret: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Email over SMTP. For Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords (16 characters, no spaces). Leave blank to skip sending.
SMTP_USER=""
SMTP_PASS=""
# Optional: defaults to Gmail (smtp.gmail.com, port 465) and "Campus Security <SMTP_USER>".
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# EMAIL_FROM="Campus Security <you@gmail.com>"
